{
  "$comment": "Canonical Co Ventures design tokens. Everything else in this repo (tokens.css, deck.css, the registry theme, the claude.ai Design System) is generated from or checked against this file. Edit here, then `npm run build:tokens`.",
  "name": "Co Ventures",
  "version": "0.1.0",
  "color": {
    "canvas":   { "value": "#f5f1ee", "role": "page background (the deck calls this cream)" },
    "surface":  { "value": "#ffffff", "role": "cards, popovers, inputs" },
    "ink":      { "value": "#1e1e1e", "role": "body copy, solid buttons, rules" },
    "ink-pure": { "value": "#000000", "role": "h1 / display headings" },
    "grey":     { "value": "#808694", "role": "secondary copy on decks" },
    "peach":    { "value": "#f6d9c0", "role": "brand tone 1 (badges, chips, deck blocks)" },
    "lavender": { "value": "#ecdcf2", "role": "brand tone 2" },
    "lime":     { "value": "#dfe8b3", "role": "brand tone 3" },
    "destructive": { "value": "#b3261e", "role": "errors, destructive actions (web only)" },
    "ink-soft":  { "value": "rgba(30,30,30,0.7)",  "role": "secondary text on canvas" },
    "ink-faint": { "value": "rgba(30,30,30,0.5)",  "role": "tertiary text" },
    "ink-hair":  { "value": "rgba(30,30,30,0.28)", "role": "hairlines, dividers" },
    "warm": { "value": ["#dae152", "#f2bc61", "#f59e8b"], "role": "warm gradient stops (decks, hero art)" },
    "cool": { "value": ["#dde8ff", "#e7ddff", "#f6b5ff"], "role": "cool gradient stops" },
    "green": { "value": "#bbed6b", "role": "green gradient end stop" },
    "neutral": {
      "role": "warm neutral ramp derived from the canvas (hue ~24deg). 100 = canvas, 900 = ink",
      "value": { "50": "#faf8f7", "100": "#f5f1ee", "200": "#e7e2de", "300": "#d6cfca", "400": "#a69e99", "500": "#78716c", "600": "#57514d", "700": "#443f3c", "800": "#2a2725", "900": "#1e1e1e", "950": "#0f0e0d" }
    },
    "accent": {
      "role": "accent ramp built out from lavender (100 = lavender)",
      "value": { "50": "#f7f2fa", "100": "#ecdcf2", "200": "#dcc6e6", "300": "#c4a6d3", "400": "#a883bd", "500": "#8f66a6", "600": "#78508d", "700": "#613f73", "800": "#4b3159", "900": "#372441", "950": "#221528" }
    },
    "chart": { "role": "deeper cousins of the badge tones, then ink and a mid neutral", "value": ["#d99a6b", "#a98bc4", "#a9b85e", "#1e1e1e", "#a69e99"] }
  },
  "gradient": {
    "warm":  "linear-gradient(135deg, #dae152 0%, #f2bc61 52%, #f59e8b 100%)",
    "cool":  "linear-gradient(135deg, #dde8ff 0%, #e7ddff 52%, #f6b5ff 100%)",
    "green": "linear-gradient(135deg, #dae152 0%, #bbed6b 100%)"
  },
  "font": {
    "display":  { "family": "Ovo", "fallback": "Georgia, \"Times New Roman\", serif", "weights": [400], "note": "Ovo ships one 400 cut. Never set bold on it; it renders faux-bold." },
    "body":     { "family": "Work Sans", "fallback": "ui-sans-serif, system-ui, sans-serif", "weights": [400, 500, 600] },
    "wordmark": { "family": "Work Sans", "tracking": "0.10em", "transform": "uppercase" },
    "google":   "https://fonts.googleapis.com/css2?family=Ovo&family=Work+Sans:wght@400;500;600&display=swap"
  },
  "type": {
    "display": { "xxl": "120px", "xl": "96px", "l": "72px", "m": "64px", "s": "48px", "xs": "32px" },
    "body":    { "l": "20px", "m": "16px", "s": "14px", "xs": "12px" },
    "leading": { "display": "1.0", "display-loose": "1.1", "body": "1.1", "web-body": "1.5", "web-h1": "1.15" },
    "tracking": { "display": "-0.02em", "display-tight": "-0.03em", "body": "-0.02em", "web-h1": "-0.01em", "wordmark": "0.10em", "label": "0.05em" }
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px", "9": "96px", "10": "120px", "11": "146px", "12": "180px" },
  "radius": {
    "none":   "0px",
    "chip":   "5px",
    "base":   "10px",
    "pill":   "30px",
    "circle": "50%",
    "$comment": "Web cards use `base`; deck cards are square (`none`). The web derives its sm/md/lg/xl scale from `base`."
  },
  "contexts": {
    "web":  { "card-radius": "base", "leading-body": "web-body", "note": "Tailwind 4 + shadcn apps. Consume tokens.css via the registry." },
    "deck": { "card-radius": "none", "leading-body": "body", "note": "Decks and plain HTML. Consume deck.css (start from templates/deck.html)." }
  }
}
